rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'technician', 'planner'])
      );
    }

    function isPlanner() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'planner';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'df7230041@gmail.com' ||
        request.auth.token.email == 'a.soekha@pixia.nl' ||
        request.auth.uid == '4eZmPRAGdNhlCXfWNQR4tTL62do2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isCustomerAccount(customerId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'customer' && getUserData().customerId == customerId;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) && 
             data.uid is string && data.email is string &&
             data.role in ['admin', 'technician', 'customer'] &&
             (data.role != 'customer' || data.keys().hasAll(['customerId']));
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 256 &&
             data.status in ['active', 'inactive', 'lead', 'prospect'];
    }

    function isValidMachine(data) {
      return data.keys().hasAll(['customerId', 'type', 'brand', 'model', 'serialNumber', 'status']) &&
             isValidId(data.customerId) &&
             data.type is string && data.brand is string && data.model is string && data.serialNumber is string &&
             data.status in ['active', 'maintenance-needed', 'faulty', 'out-of-service', 'replaced'];
    }

    function isValidIntervention(data) {
      return data.keys().hasAll(['machineId', 'customerId', 'date', 'type', 'status']) &&
             isValidId(data.machineId) && isValidId(data.customerId) &&
             data.status in ['to-be-scheduled', 'planned', 'in-progress', 'completed', 'cancelled'] &&
             data.type in ['maintenance', 'fault', 'installation', 'inspection', 'warranty', 'training', 'other'];
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'stockCount']) &&
             data.name is string && data.stockCount is number;
    }

    function isValidSmartAlert(data) {
      return data.keys().hasAll(['title', 'description', 'priority', 'status', 'type', 'createdAt', 'updatedAt']) &&
             data.priority in ['low', 'normal', 'high', 'urgent'] &&
             data.status in ['open', 'seen', 'resolved', 'dismissed'] &&
             data.type in ['stock', 'maintenance', 'warranty', 'failure', 'inactivity'];
    }

    match /smart_alerts/{alertId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidSmartAlert(incoming());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /email_templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /email_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Logs are immutable
    }

    match /outlook_connections/{connectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /automation_rules/{ruleId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isValidUser(incoming()));
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt', 'lastLogin'])); 
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaff() || isCustomerAccount(customerId);
      allow create: if isStaff() && isValidCustomer(incoming());
      allow update: if isStaff() && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /machines/{machineId} {
      allow read: if isStaff() || isCustomerAccount(existing().customerId);
      allow create: if isStaff() && isValidMachine(incoming());
      allow update: if isStaff() && isValidMachine(incoming());
      allow delete: if isAdmin();
    }

    match /interventions/{interventionId} {
      allow read: if isStaff() || isCustomerAccount(existing().customerId);
      allow create: if isStaff() && isValidIntervention(incoming());
      allow update: if isStaff() && isValidIntervention(incoming());
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidInventoryItem(incoming());
      allow update: if isStaff() && isValidInventoryItem(incoming());
      allow delete: if isAdmin();
    }

    match /work_orders/{orderId} {
      allow read: if isStaff() || isCustomerAccount(existing().customerId);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isStaff() || isCustomerAccount(existing().customerId);
      allow write: if isStaff();
    }

    match /documents/{docId} {
      allow read: if isStaff() || isCustomerAccount(existing().customerId);
      allow write: if isStaff();
    }

    match /email_templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; 
    }
  }
}
