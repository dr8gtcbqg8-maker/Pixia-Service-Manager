{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "technician", "planner", "viewer", "customer"] },
        "status": { "type": "string", "enum": ["active", "inactive", "invited"] },
        "customerId": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "internalNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System audit trail for security and monitoring",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "ipAddress": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "module", "entityType", "timestamp"]
    },
    "BusinessSettings": {
      "title": "Business Settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "kvk": { "type": "string" },
        "btw": { "type": "string" }
      }
    },
    "AppDocument": {
      "title": "Document",
      "description": "Files and documents linked to entities",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "customerId": { "type": "string" },
        "machineId": { "type": "string" },
        "interventionId": { "type": "string" },
        "workOrderId": { "type": "string" },
        "uploadDate": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url", "category", "uploadDate"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Calendar event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" },
        "interventionId": { "type": "string" }
      },
      "required": ["title", "customerId", "date", "startTime", "endTime"]
    },
    "EmailTemplate": {
      "title": "E-mail Template",
      "description": "Templates voor klantcommunicatie",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["appointment_confirmation", "maintenance_reminder", "intervention_confirmation", "work_order", "follow_up", "warranty_warning", "contract_warning", "stock_alert"] },
        "active": { "type": "boolean" },
        "placeholders": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "subject", "body", "type", "active"]
    },
    "EmailLog": {
      "title": "E-mail Log",
      "description": "Overzicht van verzonden en mislukte e-mails",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "recipient": { "type": "string" },
        "subject": { "type": "string" },
        "customerId": { "type": "string" },
        "machineId": { "type": "string" },
        "interventionId": { "type": "string" },
        "workOrderId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "sent", "failed"] },
        "error": { "type": "string" }
      },
      "required": ["timestamp", "recipient", "subject", "status"]
    },
    "OutlookConnection": {
      "title": "Outlook Connectie",
      "description": "Microsoft 365 koppelinggegevens",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "account": { "type": "string" },
        "status": { "type": "string", "enum": ["connected", "disconnected", "error"] },
        "lastSync": { "type": "string", "format": "date-time" },
        "accessToken": { "type": "string" },
        "refreshToken": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["userId", "status"]
    },
    "AutomationRule": {
      "title": "Automatisering Regel",
      "description": "Regels voor automatische e-mails",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "templateId": { "type": "string" },
        "active": { "type": "boolean" },
        "triggerDays": { "type": "number" },
        "manualCheck": { "type": "boolean" },
        "recipientType": { "type": "string", "enum": ["customer", "technician", "admin"] }
      },
      "required": ["name", "type", "templateId", "active"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Company or individual owning machines",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "billingAddress": { "type": "string" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "status"]
    },
    "Machine": {
      "title": "Machine",
      "description": "Printer, laminator or other equipment",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "type": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "serialNumber": { "type": "string" },
        "saleDate": { "type": "string", "format": "date" },
        "installDate": { "type": "string", "format": "date" },
        "warrantyPeriodMonths": { "type": "number" },
        "warrantyEndDate": { "type": "string", "format": "date" },
        "hasServiceContract": { "type": "boolean" },
        "maintenanceInterval": { "type": "string", "enum": ["monthly", "quarterly", "half-yearly", "annual", "manual"] },
        "firstMaintenanceMonths": { "type": "number" },
        "autoScheduleEnabled": { "type": "boolean" },
        "lastMaintenanceDate": { "type": "string", "format": "date" },
        "nextMaintenanceDate": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "maintenance-needed", "faulty", "out-of-service", "replaced"] },
        "notes": { "type": "string" },
        "internalNotes": { "type": "string" },
        "qrCodeUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "brand", "model", "serialNumber", "status", "autoScheduleEnabled"]
    },
    "Intervention": {
      "title": "Intervention",
      "description": "Service visit or repair",
      "type": "object",
      "properties": {
        "machineId": { "type": "string" },
        "customerId": { "type": "string" },
        "technicianId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["maintenance", "fault", "installation", "inspection", "warranty", "training", "other"] },
        "problemDescription": { "type": "string" },
        "workPerformed": { "type": "string" },
        "partsUsed": { "type": "array" },
        "hoursWorked": { "type": "number" },
        "travelTime": { "type": "number" },
        "status": { "type": "string", "enum": ["to-be-scheduled", "planned", "on-route", "in-progress", "waiting-parts", "completed", "cancelled"] },
        "followUpAction": { "type": "string" },
        "nextMaintenanceDate": { "type": "string", "format": "date" },
        "internalNotes": { "type": "string" },
        "customerNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["machineId", "customerId", "date", "type", "status"]
    },
    "WorkOrder": {
      "title": "Work Order",
      "description": "Detailed record of an intervention with legal signatures",
      "type": "object",
      "properties": {
        "interventionId": { "type": "string" },
        "customerSignature": { "type": "string" },
        "technicianSignature": { "type": "string" },
        "signedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "signed", "archived"] },
        "pdfUrl": { "type": "string" }
      },
      "required": ["interventionId", "status"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Parts and consumables",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "partNumber": { "type": "string" },
        "supplier": { "type": "string" },
        "stockCount": { "type": "number" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["name", "stockCount"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Scheduled task or alert",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "relatedId": { "type": "string" },
        "relatedType": { "type": "string", "enum": ["machine", "customer", "intervention", "inventory"] },
        "status": { "type": "string", "enum": ["open", "planned", "executed", "ignored"] },
        "description": { "type": "string" }
      },
      "required": ["type", "dueDate", "status"]
    }
    "smart_alerts": {
      "title": "Slimme Meldingen",
      "description": "Automatisch gegenereerde alerts en waarschuwingen",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "enum": ["low", "normal", "high", "urgent"] },
        "status": { "enum": ["open", "seen", "resolved", "dismissed"] },
        "type": { "enum": ["stock", "maintenance", "warranty", "failure", "inactivity"] },
        "relatedId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "priority", "status", "type", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/smart_alerts/{alertId}": {
      "schema": "smart_alerts",
      "description": "Lijst met actieve en historische meldingen"
    },
    "/users/{userId}": { "schema": "User", "description": "System users" },
    "/customers/{customerId}": { "schema": "Customer", "description": "Customer records" },
    "/machines/{machineId}": { "schema": "Machine", "description": "Machine equipment records" },
    "/interventions/{interventionId}": { "schema": "Intervention", "description": "Service interventions" },
    "/work_orders/{workOrderId}": { "schema": "WorkOrder", "description": "Signed work orders" },
    "/appointments/{appointmentId}": { "schema": "Appointment", "description": "Calendar events" },
    "/email_templates/{templateId}": { "schema": "EmailTemplate", "description": "Beheerbare e-mailtemplates" },
    "/email_logs/{logId}": { "schema": "EmailLog", "description": "Historie van verzonden e-mails" },
    "/outlook_connections/{connectionId}": { "schema": "OutlookConnection", "description": "Microsoft 365 koppelingen" },
    "/automation_rules/{ruleId}": { "schema": "AutomationRule", "description": "Regels voor e-mail automatisering" },
    "/documents/{documentId}": { "schema": "AppDocument", "description": "Stored documents" },
    "/audit_logs/{logId}": { "schema": "AuditLog", "description": "System audit trail" },
    "/inventory/{itemId}": { "schema": "InventoryItem", "description": "Spare parts and consumables" },
    "/reminders/{reminderId}": { "schema": "Reminder", "description": "System-wide reminders" },
    "/settings/business": { "schema": "BusinessSettings", "description": "Global business details" },
    "/settings/app": { "description": "App behavior settings" },
    "/settings/notifications": { "description": "Notification preferences" },
    "/settings/security": { "description": "Security protocols" }
  }
}
